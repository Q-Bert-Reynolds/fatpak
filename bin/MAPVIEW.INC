; What a Beisbol map (.gbmap) takes from its game's headers, for MAPVIEW.MOD's build: the map viewer's wrapper
; includes this (/GBCSYS/MAPVIEW.INC) instead of the project's -P file, whose headers are most of a build's time.
; Mirrors beisbolgb's src/color.inc (RGB) and src/map_loader.inc; other names a map uses (doors' targets,
; scripts, teams) aren't defined, and LINK.MOD links them as 0 (ASM_LOOSE).
MACRO RGB
  DW \3 << 10 | \2 << 5 | \1
ENDM
